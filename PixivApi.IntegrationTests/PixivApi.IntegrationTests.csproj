<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Enable Microsoft.Testing.Platform to use the MSTest runner -->
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <OutputType>exe</OutputType>

        <IsTestProject Condition="'$(RunIntegrations)' != 'true'">false</IsTestProject>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <Features>runtime-async=on</Features>
    </PropertyGroup>


    <ItemGroup>
      <ProjectReference Include="..\PixivApi\PixivApi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
      <PackageReference Include="MSTest" Version="4.2.2" />
      <PackageReference Include="System.Linq.Async" Version="7.0.1" />
    </ItemGroup>

</Project>
